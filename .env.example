# Port the server listens on (Render and most hosts set this for you).
PORT=5500
# SQLite file. The directory is created if missing. Use a persistent disk in production.
DATABASE_PATH=data/scidama.db
# Only needed when the client is served from a different origin than the server (comma-separated).
CORS_ORIGIN=
# "production" serves client/dist with a strict Content-Security-Policy.
NODE_ENV=development
# Reverse-proxy hops in front of the app (1 on Render/Fly/Railway). Defaults to 1 in production, off otherwise.
TRUST_PROXY=
